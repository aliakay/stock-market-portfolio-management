# Copy to ~/.config/borsa-radar/secrets.env (or point BORSA_RADAR_SECRETS at another file) and fill in what you have.
# Environment variables with the same names win over this file. Never commit the filled-in copy.
# Every key is optional: a feature whose key is missing is skipped, the rest keeps working.

# --- Required by SEC for automated access (fundamentals, filings): your name and a contact e-mail
SEC_USER_AGENT="Your Name you@example.com"

# --- Free API keys (sign up yourself)
FINNHUB_API_KEY=        # https://finnhub.io  · company news, earnings calendar, analyst data
FMP_API_KEY=            # https://financialmodelingprep.com  · profiles, peers, ratings (free plan has a daily limit)
FRED_API_KEY=           # https://fred.stlouisfed.org/docs/api/api_key.html  · US macro release calendar
MARKETAUX_API_KEY=      # https://www.marketaux.com  · extra news feed
SHARADAR_API_KEY=       # https://data.nasdaq.com/databases/SFA  · free "tickers" table: listed/delisted US stocks, sectors

# --- Telegram alerts (optional): create a bot with @BotFather, then send it a message and read your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Web app
BORSA_RADAR_PORT=8500
BORSA_RADAR_URL=http://localhost:8500   # the address used in Telegram links
LOCAL_TZ=Europe/Berlin                   # your time zone (quiet hours, digest times)

# --- LLM summaries (optional): the app calls an agent CLI ("hermes -z <prompt>"). Without it, LLM text is skipped.
# HERMES_BIN=/path/to/hermes
